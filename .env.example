# Copy to .env and fill in your own values. .env is gitignored.

# Discord bot token — Discord Developer Portal > your application > Bot > Token
DISCORD_BOT_TOKEN=

# Bungie API key — https://www.bungie.net/en/Application
BUNGIE_API_KEY=

# OAuth client, from the same Bungie application page. Needed only for the gear
# commands (/link, /equip, /snapshot) — everything else reads with the API key alone.
# Register the application as Confidential so it is issued a client secret: public
# clients get no refresh token, which would mean re-linking every hour.
# The OAuth scope is fixed at registration, not requested per call — the application
# needs "Move or equip Destiny gear".
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Optional. Answers "!kingsfall" style messages as well as slash commands.
# Requires the privileged MESSAGE CONTENT intent to be enabled first, under
# Developer Portal > your application > Bot > Privileged Gateway Intents.
# Leave this false if you have not enabled it — the bot will not start otherwise.
ENABLE_PREFIX_COMMANDS=false

# Optional. Where linked accounts and saved loadouts are kept. Defaults to ./state.json
# BOT_STATE_FILE=state.json
